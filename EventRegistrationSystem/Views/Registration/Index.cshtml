@model IEnumerable<EventRegistrationSystem.Models.Registration>
@{
    ViewData["Title"] = "Kayıtlar";
}

<h1>Kayıtlar</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Yeni Kayıt Oluştur</a>
</p>

<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>@Html.DisplayNameFor(model => model.Event)</th>
            <th>@Html.DisplayNameFor(model => model.Participant)</th>
            <th>@Html.DisplayNameFor(model => model.RegistrationDate)</th>
            <th>İşlemler</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>@Html.DisplayFor(modelItem => item.Event.EventName)</td>
            <td>@Html.DisplayFor(modelItem => item.Participant.FullName)</td>
            <td>@item.RegistrationDate.ToString("g")</td>
            <td>
                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Sil</a>
            </td>
        </tr>
}
    </tbody>
</table>
