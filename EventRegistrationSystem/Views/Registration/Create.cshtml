@model EventRegistrationSystem.Models.Registration
@{
    ViewData["Title"] = "Yeni Kayıt";
}

<h1>Yeni Kayıt Oluştur</h1>

<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group mb-3">
                <label asp-for="EventId" class="control-label"></label>
                <select asp-for="EventId" class="form-control" asp-items="ViewBag.EventId"></select>
                <span asp-validation-for="EventId" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="ParticipantId" class="control-label"></label>
                <select asp-for="ParticipantId" class="form-control" asp-items="ViewBag.ParticipantId"></select>
                <span asp-validation-for="ParticipantId" class="text-danger"></span>
            </div>
            <div class="form-group mt-4">
                <input type="submit" value="Kayıt Ol" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Listeye Dön</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
